@namespace Huge.Lottie
@using Huge.MoveLit.Enums;
@inherits ModuleBase

@if (!_loading)
{
    <div class="container">

        <!-- Radio buttons to choose the source type -->
        <div class="row mb-3">
            <div class="col-sm-3">
                <label class="form-label">Source Type</label>
            </div>
            <div class="col-sm-9">
                <div class="form-check form-check-inline">
                    <input class="form-check-input"
                           type="radio"
                           id="sourceLottie"
                           name="sourceType"
                           value="@NotifyPropertyName.Lottie"
                           checked="@(_sourceType == NotifyPropertyName.Lottie)"
                           @onchange="() => SetSourceType(NotifyPropertyName.Lottie)">
                    <label class="form-check-label" for="sourceLottie">Lottie</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input"
                           type="radio"
                           id="sourceImage"
                           name="sourceType"
                           value="@NotifyPropertyName.Image"
                           checked="@(_sourceType == "lottie")"
                           @onchange="() => SetSourceType(NotifyPropertyName.Image)">
                    <label class="form-check-label" for="sourceImage">Image</label>
                </div>
            </div>
        </div>

        @if (_sourceType == NotifyPropertyName.Lottie)
        {
            <div class="row mb-1 align-items-center">
                <label class="form-label col-sm-3" for="lottie-source">Lottie Source</label>
                <div class="col-sm-9">
                    @if (_useLottieUrl)
                    {
                        <input id="lottie-source" type="text" class="form-control" @bind="_settingsVM.LottieSource" />
                    }
                    else
                    {
                        <input id="lottiePath" class="form-control" @bind="_settingsVM.LottieSource" disabled />
                        <FileManager OnSelectFile="fileId => HandleUpload(fileId)"></FileManager>
                    }
                    <div class="form-check">
                        <input class="form-check-input mt-2"
                               type="checkbox"
                               id="lottieUrlToggle"
                               @bind="_useLottieUrl" />
                        <label class="form-check-label mt-2" for="lottieUrlToggle">
                            Use external lottie URL
                        </label>
                    </div>
                </div>
            </div>
        }
        else if (_sourceType == NotifyPropertyName.Image)
        {
            <div class="row mb-1 align-items-center">
                <label class="form-label col-sm-3" for="img-source">Image Source</label>
                <div class="col-sm-9">
                    @if (_useImageUrl)
                    {
                        <input id="img-source" type="text" class="form-control" @bind="_settingsVM.ImgSource" />
                    }
                    else
                    {
                        <input id="imagePath" class="form-control" @bind="_settingsVM.ImgSource" disabled />
                        <FileManager OnSelectFile="fileId => HandleUpload(fileId)"></FileManager>
                    }
                    <!-- TODO: replace with file picker if desir<Settings />ed -->
                    <div class="form-check mt-2">
                        <input class="form-check-input mt-2"
                               type="checkbox"
                               id="lottieUrlToggle"
                               @bind="_useImageUrl" />
                        <label class="form-check-label mt-2" for="lottieUrlToggle">
                            Use external image URL 
                        </label>
                    </div>
                </div>
            </div>
        }
    </div>

}