@namespace Huge.Dashboard
@using Huge.MovLit.Enums
@using System.Linq
@inherits Oqtane.Modules.ModuleBase

<div class="mb-4">
    <div class="fw-semibold text-uppercase small text-muted mb-2">Popular Tags</div>
    <div class="row row-cols-2 g-2">
        @foreach (var tag in _tags.Take(Count))
        {
            var disabled = DisableInteraction || _isBrowseContext;
            <div class="col">
                <a class="link-body-secondary h5 d-inline-block @(disabled ? "disabled text-muted" : string.Empty)" style="text-decoration:none;cursor:@(disabled ? "default" : "pointer");" @onclick="(() => { if(!disabled) GoTag(tag); })">@tag</a>
            </div>
        }
        @if (ShowBrowseAllLink)
        {
            var disabled = DisableInteraction || _isBrowseContext;
            <div class="col-12">
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center justify-content-center" disabled="@disabled" @onclick="GoAllTags" style="cursor:@(disabled ? "default" : "pointer");">
                    <span>Browse all tags</span>
                    <span class="bi bi-arrow-right"></span>
                </button>
            </div>
        }
    </div>
</div>

@code {
    void NavigateToTag(string tag)
    {
        NavigationManager.NavigateTo($"/dashboard/browse?tag={Uri.EscapeDataString(tag)}");
    }

    void NavigateToAllTags()
    {
        // ensure browse page loads in tag mode without a pre-selected tag
        NavigationManager.NavigateTo("/dashboard/browse?mode=tag");
    }
}


