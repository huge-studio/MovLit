@namespace Huge.Ink
@inherits ModuleBase

@if (loading)
{
    <div class="p-3">
        <div class="placeholder-glow mb-2">
            <span class="placeholder col-12" style="height:40px;"></span>
        </div>
        <div class="placeholder-glow mb-2">
            <span class="placeholder col-6"></span>
        </div>
        <div class="placeholder-glow mb-2">
            <span class="placeholder col-8"></span>
        </div>
        <div class="placeholder-glow mb-2">
            <span class="placeholder col-4"></span>
        </div>
    </div>
}
else
{
    <div class="row mb-1 align-items-center">
        <label class="form-label col-sm-3" for="image-base">Continue Button Text: </label>
        <div class="col-sm-9">
            <input id="image-base" type="text" class="form-control" @bind="@_settingsVM.ContinueText" />
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <label class="form-label col-sm-3" for="use-prev">Use Previous</label>
        <div class="col-sm-9 d-flex align-items-center">
            <input id="use-prev" type="checkbox" class="form-check-input me-2" @bind="@_settingsVM.HasPrevious" />
            <span class="text-muted small">Enable Previous button in the Ink UI</span>
        </div>
    </div>
}
