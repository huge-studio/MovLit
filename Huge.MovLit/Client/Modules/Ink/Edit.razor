@using Oqtane.Modules.Controls
@using Huge.MovLit.Services
@using Huge.MovLit.Models
@namespace Huge.Ink

@inherits ModuleBase

<div class="container py-3">
    <div class="row mb-3">
        <div class="col">
            <h5 class="m-0">Edit Story</h5>
            <div class="text-muted small">Module @ModuleState.ModuleId</div>
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <Label For="title" Class="col-sm-3">Title</Label>
        <div class="col-sm-9">
            <input id="title" class="form-control" placeholder="Enter title" />
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <Label For="author" Class="col-sm-3">Author</Label>
        <div class="col-sm-9">
            <input id="author" class="form-control" placeholder="Enter author" />
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <Label For="desc" Class="col-sm-3">Description</Label>
        <div class="col-sm-9">
            <textarea id="desc" rows="3" class="form-control" placeholder="Short description"></textarea>
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <Label For="coverart" Class="col-sm-3">Cover Art</Label>
        <div class="col-sm-9">
            <input id="coverart" class="form-control mb-2" placeholder="/files/cover.jpg" value="@_coverArtUrl" disabled />
            <FileManager OnSelectFile="(fileId) => OnCoverSelected(fileId)" />
            @if (!string.IsNullOrWhiteSpace(_coverArtUrl))
            {
                <div class="form-text">Selected: @_coverArtUrl</div>
            }
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <Label For="tags" Class="col-sm-3">Tags</Label>
        <div class="col-sm-9">
            <select id="tags" multiple class="form-select" @onchange="OnTagsChanged">
                @foreach (var t in _allTags)
                {
                    <option value="@t" selected="@_selectedTags.Contains(t)">@t</option>
                }
            </select>
            <div class="form-text">Hold Ctrl/Cmd to select multiple.</div>
        </div>
    </div>

    <hr />

    <div class="row mb-2 align-items-center">
        <Label For="ink" Class="col-sm-3">Ink</Label>
        <div class="col-sm-9">
            <textarea id="ink" rows="10" class="form-control" placeholder="// Ink content here"></textarea>
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <Label For="continue" Class="col-sm-3">Continue Button Text</Label>
        <div class="col-sm-9">
            <input id="continue" class="form-control" placeholder="Continue" />
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="button" class="btn btn-success" @onclick="Save">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </div>
</div>