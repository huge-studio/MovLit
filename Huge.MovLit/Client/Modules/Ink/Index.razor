@namespace Huge.Ink
@inherits ModuleBase

@if (PageState.EditMode)
{
    <div class="card m-2" style="position:relative;">
        <div class="card-body d-flex flex-column flex-sm-row align-items-start gap-2">
            <h6 class="card-title text-primary m-0 me-auto">Ink Module</h6>
            <a class="btn btn-primary" href="@_settingsUrl">
                <span class="bi bi-gear"></span> Settings
            </a>
            <a class="btn btn-primary" href="@_editUrl">
                <span class="bi bi-gear"></span> Edit Story
            </a>
        </div>
    </div>
}
else if (loading)
{
    <div class="p-3 d-flex flex-column justify-content-center align-items-center">

        <div class="placeholder-glow mb-3 w-100">
            <span class="placeholder col-12" style="height:60px;"></span>
        </div>

        <div class="d-flex justify-content-center">
            <div class="placeholder-glow mx-2">
                <a class="btn btn-primary disabled placeholder col-6"
                   style="height:38px; width:150px;" aria-disabled="true"></a>
            </div>
            <div class="placeholder-glow mx-2">
                <a class="btn btn-primary disabled placeholder col-6"
                   style="height:38px; width:150px;" aria-disabled="true"></a>
            </div>
        </div>
    </div>
}
else
{
    <div class="ink-container">
        <div class="card mb-3 prompt-card">
            <div class="card-body">
                <div class="prompt-text @( _settingsVM.CenterJustify ? "text-center" : string.Empty )" data-center-text="@_settingsVM.CenterJustify.ToString()">
                    @_currentLine
                </div>
            </div>
        </div>

        @if (_currentChoices.Any())
        {
            <div class="d-flex flex-wrap justify-content-center p-3 gap-2">
                @if (_hasPrevious)
                {
                    <button class="btn btn-secondary btn-lg" @onclick="Previous">Previous</button>
                }
                @foreach (var choice in _currentChoices)
                {
                    <InkChoice Choice="choice" OnSelected="ChoiceSelected" />
                }
            </div>
        }
        else if (_hasPrevious || _hasNext || _hasFinish)
        {
            <div class="d-flex flex-wrap justify-content-center p-3 gap-2">
                @if (_hasPrevious)
                {
                    <button class="btn btn-secondary btn-lg" @onclick="Previous">Previous</button>
                }
                @if (_hasNext)
                {
                    <button class="btn btn-primary btn-lg" @onclick="Next">@_settingsVM.ContinueText</button>
                }
            </div>
        }
    </div>
}
